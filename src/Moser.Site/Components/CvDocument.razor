<article class="cv" lang="en">
    <header class="cv-head">
        <h1>@SiteCopy.Name</h1>
        <p class="cv-title">@SiteCopy.Title</p>
        <p class="cv-contact">@SiteCopy.Place · @SiteCopy.Email · @SiteCopy.Phone</p>
        <p class="cv-contact">@SiteCopy.LinkedInHandle · @SiteCopy.GitHubHandle</p>
    </header>

    <section>
        <h2>Profile</h2>
        <p>@WorkHistory.Profile</p>
    </section>

    <section>
        <h2>Technical skills</h2>
        <p><span class="cv-label">Languages</span> C#, SQL, JavaScript</p>
        <p><span class="cv-label">Backend</span> ASP.NET Core, REST APIs, Entity Framework Core, Blazor</p>
        <p><span class="cv-label">Delivery</span> Azure DevOps, Docker, CI/CD</p>
        <p><span class="cv-label">Cloud</span> Microsoft Azure</p>
        <p><span class="cv-label">Data</span> SQL Server, PostgreSQL, PostGIS, T-SQL / SQL</p>
    </section>

    <section>
        <h2>Experience</h2>

        <h3>@WorkHistory.CurrentRole — @WorkHistory.CurrentEmployer</h3>
        <p class="cv-meta">@WorkHistory.CurrentDates · @WorkHistory.CurrentPlace</p>

        @foreach (var item in WorkHistory.CurrentClients)
        {
            <h4>@item.Name</h4>
            <p class="cv-meta">@item.Dates · @item.Place</p>
            <ul>
                @foreach (var note in item.Notes)
                {
                    <li>@note</li>
                }
                @if (!string.IsNullOrEmpty(item.Url))
                {
                    <li>@item.Url</li>
                }
            </ul>
        }
    </section>

    <section class="cv-page-2">
        <h3>@WorkHistory.ThermoFisher.Role — @WorkHistory.ThermoFisher.Name</h3>
        <p class="cv-meta">@WorkHistory.ThermoFisher.Dates · @WorkHistory.ThermoFisher.Place</p>
        <ul>
            @foreach (var note in WorkHistory.ThermoFisher.Notes)
            {
                <li>@note</li>
            }
        </ul>

        <h3>@WorkHistory.SocialnaPoistovna.Role — @WorkHistory.SocialnaPoistovna.Name</h3>
        <p class="cv-meta">@WorkHistory.SocialnaPoistovna.Dates · @WorkHistory.SocialnaPoistovna.Place</p>
        <ul>
            @foreach (var note in WorkHistory.SocialnaPoistovna.Notes)
            {
                <li>@note</li>
            }
        </ul>

        <h3>@WorkHistory.Frequentis.Role — @WorkHistory.Frequentis.Name</h3>
        <p class="cv-meta">@WorkHistory.Frequentis.Dates · @WorkHistory.Frequentis.Place</p>
        <ul>
            @foreach (var note in WorkHistory.Frequentis.Notes)
            {
                <li>@note</li>
            }
        </ul>

        <h2>Languages</h2>
        <p>Slovak (native), English (professional).</p>
    </section>
</article>
