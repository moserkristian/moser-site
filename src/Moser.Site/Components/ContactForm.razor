@inject HttpClient Http
@inject IConfiguration Config
@inject NavigationManager Nav
@implements IDisposable

<form class="contact-form" method="post" novalidate @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <div class="hp" aria-hidden="true">
        <label>
            Website
            <input @bind="Model.Website" tabindex="-1" autocomplete="off" />
        </label>
    </div>

    <p>
        <label for="contact-name">Name</label>
        <input id="contact-name" name="name" autocomplete="name" required maxlength="100" @bind="Model.Name" />
    </p>
    <p>
        <label for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" @bind="Model.Email" />
    </p>
    <p>
        <label for="contact-company">Company</label>
        <input id="contact-company" name="company" autocomplete="organization" maxlength="200" @bind="Model.Company" />
    </p>
    <p>
        <label for="contact-need">What do you need</label>
        <select id="contact-need" name="need" @bind="Model.Need">
            <option value="">Choose a service</option>
            @foreach (var need in ServicesOffered.ContactNeeds)
            {
                <option value="@need.Id">@need.Label</option>
            }
        </select>
    </p>
    <p>
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" required minlength="10" maxlength="4000" rows="8" @bind="Model.Message"></textarea>
    </p>

    @if (Errors.Count > 0)
    {
        <ul class="form-errors" role="alert">
            @foreach (var error in Errors)
            {
                <li>@error</li>
            }
        </ul>
    }

    @if (Succeeded)
    {
        <p class="form-ok" role="status">@ContactValidation.SuccessMessage</p>
    }

    <p>
        <button type="submit" class="button" disabled="@Busy">Send</button>
    </p>
</form>

@code {
    private ContactRequest Model { get; set; } = new();
    private List<string> Errors { get; set; } = [];
    private bool Busy { get; set; }
    private bool Succeeded { get; set; }

    protected override void OnInitialized()
    {
        ApplyNeedFromQuery();
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyNeedFromQuery();
        StateHasChanged();
    }

    private void ApplyNeedFromQuery()
    {
        var need = QueryValue(Nav.Uri, "need");
        if (ServicesOffered.IsKnownNeed(need) && !string.IsNullOrWhiteSpace(need))
        {
            Model.Need = need.Trim().ToLowerInvariant();
        }
    }

    private async Task SubmitAsync()
    {
        Succeeded = false;
        Errors = ContactValidation.Validate(Model).ToList();
        if (Errors.Count > 0)
        {
            return;
        }

        if (ContactValidation.IsHoneypotFilled(Model))
        {
            Succeeded = true;
            Model = new ContactRequest();
            return;
        }

        Busy = true;
        try
        {
            var path = Config["ContactApiPath"] ?? "api/contact";
            using var response = await Http.PostAsJsonAsync(path, Model);
            if (response.IsSuccessStatusCode)
            {
                Succeeded = true;
                Model = new ContactRequest();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var problem = await response.Content.ReadFromJsonAsync<ContactProblem>();
                Errors = problem?.Errors?.ToList() ?? ["Check the form and try again."];
            }
            else
            {
                Errors = ["The form could not be sent. Email instead."];
            }
        }
        catch (HttpRequestException)
        {
            Errors = ["The form could not be sent. Email instead."];
        }
        finally
        {
            Busy = false;
        }
    }

    private static string? QueryValue(string uri, string key)
    {
        var query = new Uri(uri).Query;
        if (query.Length < 2)
        {
            return null;
        }

        foreach (var part in query.TrimStart('?').Split('&'))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && Uri.UnescapeDataString(pair[0]).Equals(key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(pair[1].Replace('+', ' '));
            }
        }

        return null;
    }

    private sealed class ContactProblem
    {
        public IReadOnlyList<string>? Errors { get; set; }
    }
}
