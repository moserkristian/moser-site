@page "/contact"

<PageTitle>Contact — @SiteCopy.Brand</PageTitle>

<h1>Contact</h1>
<p class="lede">Email is the reliable path. The form is optional.</p>

<div class="contact-split">
    <aside class="contact-aside">
        <p>
            <a href="mailto:@SiteCopy.Email">@SiteCopy.Email</a><br />
            <a href="@SiteCopy.LinkedIn">@SiteCopy.LinkedInHandle</a>
        </p>
        <p class="meta">@SiteCopy.Company · Bratislava or remote</p>
    </aside>
    <ContactForm />
</div>
