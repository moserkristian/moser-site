{
  "platform": {
    "apiRuntime": "dotnet-isolated:8.0"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/css/*",
      "/_framework/*",
      "/Kristian-Moser-CV.pdf",
      "/*.{txt,json,wasm,dat,dll,pdb,blat,png,svg,ico,webp,css,js,map,woff,woff2,pdf}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY"
  }
}
